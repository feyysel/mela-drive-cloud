# display name of the service
APP_NAME=
# allowed: dev | prod
APP_ENV=
# e.g. 8080
APP_PORT=
# root domain. e.g. example.com
APP_DOMAIN=
# email of the owner account seeded on startup
APP_OWNER_EMAIL=
# initial password of the owner account seeded on startup
APP_OWNER_PASSWORD=
# comma-separated allowed origins. wildcards (*) are forbidden
APP_ALLOWED_ORIGINS=

# e.g. postgres://user:password@localhost:5432/db_name
DATABASE_URL=
# e.g. redis://:password@localhost:6379/0
REDIS_URL=

# cloudflare r2 / s3 api endpoint
STORAGE_R2_ENDPOINT=
# custom domain or public dev url for uploaded files. e.g. https://cdn.example.com or https://pub-xxx.r2.dev
STORAGE_PUBLIC_BASE_URL=
# r2 / s3 access key id
STORAGE_ACCESS_KEY_ID=
# r2 / s3 secret access key
STORAGE_SECRET_ACCESS_KEY=
# bucket name for uploaded files
STORAGE_BUCKET=

# resend api key
MAIL_API_KEY=
# verified sending domain. e.g. notify.example.com
MAIL_DOMAIN=